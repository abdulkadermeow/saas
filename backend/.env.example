APP_NAME="Rafiq Platform API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Damascus
APP_URL=https://api.example.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# رابط الداشبورد (مهم للـ CORS ولروابط الدفع)
FRONTEND_URL=https://app.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# قاعدة البيانات — داخل دوكر اترك DB_HOST=db
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=rafiq
DB_USERNAME=rafiq
DB_PASSWORD=change-me-strong-password

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# سر مشترك بين الباك إند و n8n (ولّده بـ: openssl rand -hex 32)
N8N_SHARED_SECRET=

# بوابة الدفع: stripe أو manual
PAYMENT_GATEWAY=stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# عند استخدام PAYMENT_GATEWAY=manual: رقم واتساب أو رابط تعليمات الدفع اليدوي
MANUAL_PAYMENT_CONTACT=
